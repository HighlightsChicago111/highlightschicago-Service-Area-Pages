  var define_REVIEWS_default = [{ reviewer: "Tony", rating: "5.0", iso_date: "2026-04-06T18:24:11Z", review: `After months of being ghosted or overquoted by other electricians in Chicago, finding Highlights Chicago was a total game-changer. I needed several installs, pendant lights, a ceiling fan, and vanity lights but most companies either dragged their feet on quotes or gave me "I don't want to do this" pricing. One competitor, Mr. Mighty Electric, quoted me 3x the rate and charged a trip fee just to look at the place! Boz (the owner) was a true professional from the start. He came out for a walkthrough the same week I called, took detailed notes, and was incredibly respectful (he even took his shoes off without being asked). He promised a quote the next day and delivered a very reasonable, detailed estimate. On installation day, Boz arrived on time with three workers, gave them a clear game plan, and specifically instructed them to minimize wall damage to save me from extra painting. The crew was fantastic they checked in with me on heights for the fan and pendants before finalizing anything. They worked for 8 hours and the result was outstanding. I was so happy with the quality that I tipped the whole crew. If you want fair pricing and high quality work, call Highlights. I’ll be using them for every future project!`, review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT205VlV6STBWemN6V2tOVGFtZHZiVUYwYjBRd1UwRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOm9VUzI0VzczWkNTamdvbUF0b0QwU0E%7C%7C?hl=en-US" }, { reviewer: "Mihailo Rakovic", rating: "5.0", iso_date: "2026-05-02T20:58:45Z", review: "I cannot recommend Highlights Chicago highly enough. From the initial consultation to the completion of the job, the team was exceptionally professional, punctual, and knowledgeable. They took the time to explain the work needed, ensured everything was completed to the highest safety standards, and treated my property with great respect. The work area was left spotless, and the pricing was fair and transparent. If you need reliable electrical work done, look no further!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2pkUFNFTXdaVTUxUVhscWNHUTJhV0l0TUhsSmJIYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOjdPSEMwZU51QXlqcGQ2aWItMHlJbHc%7C%7C?hl=en-US" }, { reviewer: "Jose Gonzalez", rating: "5.0", iso_date: "2026-02-04T21:11:20Z", review: "This company is by far the best I’ve worked with since I bought my house. Boz is very professional, intelligent, & helpful. Him and his team were all hard workers and had a clean install with my Tesla car charger. You can tell they care about doing excellent work and making you happy. They worked outdoors even in cold conditions. The best part is they are very reasonable with their prices compared to competitors in the area. I’m definitely hiring them again for anything electrical in the future! Don’t think twice. Hire these guys Asap!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25aS1UwTllNMkZxVnpoS05UVkNWMmRFV1dOaGVXYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOnZKU0NYM2FqVzhKNTVCV2dEWWNheWc%7C%7C?hl=en-US" }, { reviewer: "Tristan Adriatico", rating: "5.0", iso_date: "2026-03-10T17:15:10Z", review: "Called them at 9 am on a Saturday morning and they were able to send someone to my house by 10 am the same day. I had Kaplan and Gerardo as my electricians. They did a great job installing 2 indoor sconces and 2 kitchen pendant lights. My pendant lights were pretty difficult to install but they took the time to make sure they weren’t crooked. Seriously they must have spent more than an hour just leveling my lights! In the end they turned out so good!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2w4eWRrTlBiakpETlZCd2FtSlVORGxuUVRsa2QxRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOl8ydkNPbjJDNVBwamJUNDlnQTlkd1E%7C%7C?hl=en-US" }, { reviewer: "Sheldon Ruttenberg", rating: "5.0", iso_date: "2026-04-16T17:44:33Z", review: `honestly......  are you looking for an electrician contractor company with superb skill sets, competitive in price, with knowledgeable, experienced and professional electricians ?  then please ......read this review…  After receiving several quotes for new electric breaker panels for our home’s electrical system,  I chose Highlights Chicago.  but the real value of an electrical contractor company ...which I soon discovered….  is the scope and knowledge level, attentiveness, need assessment, skill, confidence, courteousness and integrity of your electrical contractor  ..... And of course a very competitive price…..  I was very impressed by the knowledge level of Boz (President) and his team’s professionalism and dedication to make their customer happy and satisfied in every facet…..and going above and beyond my expectations.  one word..... "exemplary"........in every way....  The electricians worked very hard and at all times were friendly, respectful and courteous.  They got the job done as promised and I would definitely recommend them for your electrical needs.  Highlights Chicago is an electrical contractor that is a model that should set the standard for other companies, for they shine bright and above the horizon….  And this is the truth.  I am extremely happy and I value this relationship with their entire team of electricians. ‘ Hat's off to the entire team of Highlights Chicago …...they are the bee's knees in trust, dedication and professionalism in truly getting it right ....  Thank you Boz and all the team!  Sheldon Ruttenberg`, review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25CSWRrdGpVVk5mWDFsc01YRXRhREpPVDFsaGNtYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOnBIdktjUVNfX1lsMXEtaDJOT1lhcmc%7C%7C?hl=en-US" }, { reviewer: "Camille Medina", rating: "5.0", iso_date: "2025-12-22T15:41:12Z", review: "Amazing to work with. I had a Tesla charger installed in my detached garage and also had my electrical panel upgraded. The original estimate was that the work would take 2–3 days, but the team completed everything in just one day. The pricing was very reasonable, and all work was done cleanly and professionally.  Boz was my main point of contact and did a great job keeping me up to date throughout the process. He also followed up afterward to make sure I applied for the ComEd EV charger credits in time, which I really appreciated.  Everything was completed up to code and passed inspection without any issues. I would definitely recommend them for EV charger installations and electrical upgrades.", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xCMWRHTkVhRGg0YjNkeWNYSjBZVTFQTUROa09WRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOlB1dGNEaDh4b3dycXJ0YU1PMDNkOVE%7C%7C?hl=en-US" }, { reviewer: "Alice Bils", rating: "5.0", iso_date: "2026-07-03T18:13:52Z", review: "I cannot say enough great things about Juve and Christian from Highlights Chicago! From start to finish, they were professional, thorough, and an absolute pleasure to work with. They arrived fully prepared with all the necessary equipment and even brought furniture coverings to make sure everything was protected — a thoughtful touch that didn't go unnoticed. They replaced my track lighting and installed pendant lighting, and what really stood out was their patience throughout the process. As I worked through adjusting the lengths, they offered genuine perspective and insight that helped me make the right decisions rather than just telling me what I wanted to hear. They walked me through every step of what they were doing, which made the whole experience feel collaborative and stress-free. And as if that wasn't enough — they were incredibly gracious about my dog, who was absolutely convinced he was the most important member of the crew (he was not). They never skipped a beat! If you are looking for electricians who are skilled, professional, and genuinely go above and beyond, look no further. Juve and Christian are the best in the business. Highlights Chicago has earned a customer for life!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tsWWFWSXlMVlpMYjNseU9GRnNWbXRKZGtabWFFRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOklYaVIyLVZLb3lyOFFsVmtJdkZmaEE%7C%7C?hl=en-US" }, { reviewer: "Francisco Moya", rating: "5.0", iso_date: "2025-10-26T02:27:37Z", review: 'We simply cannot recommend Highlights Chicago highly enough. They handled all the electrical work for our new house, which is a massive job, and they were truly outstanding from start to finish. Right from the initial meeting, Boz was fantastic. He gave us a very accurate, honest assessment of exactly what our new home needed and never once tried to upsell or push unnecessary work—something we really appreciated in the middle of a big build. His estimates were delivered precisely when promised, keeping our project on schedule. The work itself was of exceptionally high quality. They wired our entire house in a timely manner, and the result is honestly outstanding. The ultimate seal of approval came from the city inspector, who actually went out of his way to compliment the new service installation, saying it was "done by the books." That kind of third-party praise speaks volumes about the quality and professionalism of their team. Boz and his crew were always professional, easy to reach, and punctual. They took the time to clarify all our questions and made sure we understood what was being done every step of the way. If you need reliable, high-quality electrical work done, I would recommend Highlights Chicago in a heartbeat.', review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xaVWRFeDNRMk15ZUhoaU1rWXhTa3hVZVVGV2QzYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOlZUdEx3Q2MyeHhiMkYxSkxUeUFWd3c%7C%7C?hl=en-US" }, { reviewer: "Shari J", rating: "5.0", iso_date: "2026-05-26T14:16:01Z", review: "Highly recommend Highlights Chicago. Boz, the owner, is very knowledgeable and patiently addressed all my questions and concerns before we began the project. Victor, Oscar, and Segundo were great to work with—they did an excellent and efficient job installing several new lighting fixtures, and installed an extra fixture at no charge. Victor was even kind enough to carry upstairs a very heavy package that had been delivered to me that day. I will definitely use Highlights Chicago again!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25KVFIydEdZamczY0RkSGNUSnFTemhXVkU5SmIxRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOnJTR2tGYjg3cDdHcTJqSzhWVE9Jb1E%7C%7C?hl=en" }, { reviewer: "Nadia V", rating: "5.0", iso_date: "2025-10-13T23:00:43Z", review: "My roommates and I recently hired Highlights for a panel upgrade, and the entire experience was excellent from start to finish. Our initial point of contact was Anna at the office, who was super friendly and made scheduling everything really easy. We felt well taken care of from the first call. Boz was the electrician we worked with, and we couldn’t be happier. He was knowledgeable, efficient, and clearly takes pride in his work. Everything was done neatly, on time, and with great attention to detail. It's a huge relief knowing our electrical system is now up to date and in such good hands. Highly recommend!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2kwNGNVdzVTV1JCVUY5dlNGQXdWRFpGUjFOVUxXYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOi04cUw5SWRBUF9vSFAwVDZFR1NULWc%7C%7C?hl=en" }, { reviewer: "Doni Goodman", rating: "5.0", iso_date: "2025-09-23T14:58:43Z", review: "Boz and his crew were absolute legends. Kind and efficient. Their work was super clean. They were able to install an EV charger in my garage in just 3-4 hours, including trenching. These guys are wizards. And on top of it, everyone was a total sweat heart. Could not recommend Highlights and Boz's team enough - Specifically Kaplan, Jerardo, and Roberto! So happy to know I have a trusted electrician to reach out to when the next job calls.  Thanks again!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xBMVJWUnVlUzFzWlROMmVsOTNMVEZGVGtoNVlrRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOlA1RVRueS1sZTN2el93LTFFTkh5YkE%7C%7C?hl=en" }, { reviewer: "Eric Dynowski", rating: "5.0", iso_date: "2026-06-03T12:11:02Z", review: "Truly impressed by the entire Highlights team. We upgraded the electrical feed to our garage, and a team of 5 people completed the entire project in under 8 hours. Boz, the owner, is friendly, practical, and a pleasure to work with. No drama and very organized. The quality of the work was A+, and the pricing was excellent. Would hire them again anytime!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21kT1VVdGtVVmRhYm1SZlgxbFdVREJWYTNKcE0zYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOmdOUUtkUVdabmRfX1lWUDBVa3JpM3c%7C%7C?hl=en" }, { reviewer: "Andres Avendaño", rating: "5.0", iso_date: "2026-03-01T05:07:23Z", review: "We had a great experience with Highlights Chicago. From the first call, Boz was prompt and professional in scoping the work and provided an adequate and transparent quote.  Oscar and Victor helped us install several new light fixtures and outdoor outlet covers. They were professional, knowledgeable, and extremely detail-oriented. What stood out most was their commitment to doing the job right. They took the time to explain everything and ensured each installation was completed perfectly.  We highly recommend Highlights Chicago and will definitely work with them again.", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25SSWMybDJja0V4T0dweWMyNXdVRVZDZGs5R2QxRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOnRIc2l2ckExOGpyc25wUEVCdk9Gd1E%7C%7C?hl=en" }, { reviewer: "Marko Mihailovic", rating: "5.0", iso_date: "2026-03-11T05:11:46Z", review: "I had a great experience with Highlights Chicago this past Saturday. It’s not always easy to find a company willing to come out on the weekend, but their team was responsive, professional, and very efficient. The electrician quickly diagnosed the issue, explained everything clearly, and completed the work with excellent attention to detail.  What really stood out was how much they genuinely care about their customers. They took the time to make sure everything was working perfectly before leaving and made the whole process smooth and stress-free. It’s clear this family-owned company takes pride in providing high-quality service. I highly recommend Highlights Chicago to anyone looking for reliable electricians.", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xablQyNVhUMGxFTjFwTWJGRnVURkpGWkU5b1pVRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOlZnT25XT0lEN1pMbFFuTFJFZE9oZUE%7C%7C?hl=en" }, { reviewer: "Olha Rossokhata", rating: "5.0", iso_date: "2026-04-01T00:58:54Z", review: "Great experience with this company updating the panel in our new home. Anna from the office made scheduling easy and clearly explained the process. Boz was great to work with—he was friendly, easy to talk to, and gave clear information on cost and timing. The work was done quickly and professionally. Highly recommend!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25nelNraERjMWg0VUZNNVJYWnpaMVJHYzFSeU1HYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOngzSkhDc1h4UFM5RXZzZ1RGc1RyMGc%7C%7C?hl=en" }, { reviewer: "YouTube Stream", rating: "5.0", iso_date: "2026-01-19T18:34:23Z", review: "Excellent process end-to-end! I will recommend and use these guys for all of my electrical needs going forward.  I needed to upgrade my garage to 220 and have an EV installed and Boz and his team did a great job specing the project and following through on their plan. They were smart and considerate about the most efficient to run the lines through my yard to the garage.  Other companies that came to review the job either suggested the copout strategy of running an overheard wire (dangerous and not up to code I've learned) or a complex operation that involved breaking up my concrete walkway (and having to hire someone else to repair it!). The Highlights team were thoughtful about their approach and figured out a plan that was the least invasive path and utilized their skillsets of trenching and running pipe as incognitio as possible. Very cool!  The work was completed in a timely fashioned, not rushed. Each member of the crew was friendly, knowledgeable and hard-working - which shows a lot about the character and culture of the company. It was tested, I was walked though what they were doing while they did it and then they cleaned up like they were never here!  The final install (photos coming) is clean and functional. Highly recommended!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT25ScmVHRlpValJMV1Y4NFFWaFdaR1YxVWtkU1RWRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOnRreGFZUjRLWV84QVhWZGV1UkdSTVE%7C%7C?hl=en" }, { reviewer: "DiCostanzo", rating: "5.0", iso_date: "2026-04-08T20:51:19Z", review: "This is the second time I have used Highlights and both time they have been great. Responsive, timely, and fair pricing.  Gig was the technician on site and he did an excellent job. He was able to quickly assess the issue, explain the issue in laymen’s terms and correct it the same day. Even able to take on additional issues from my tenants that we found out about together.", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2tONGVVSjVWVjlCTTJOcGIzcFhhelF5Y1VGZldGRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOkN4eUJ5VV9BM2Npb3pXazQycUFfWFE%7C%7C?hl=en" }, { reviewer: "liz smiley", rating: "5.0", iso_date: "2025-11-28T22:04:08Z", review: "We got several estimates to have recessed lighting put in our condo (17 in total). Not only was Highlights Chicago the best cost wise, but they were in depth with the estimate and very responsive to any questions we had prior to the project. Victor, Benjamin & Gus arrived on time, were very friendly, detailed with covering everything in plastic and did an excellent job installing our lights. We were absolutely thrilled with result and will not hesitate to recommend Highlights to our friends and family.", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21SVlNEbHpSMFZ4TWpCd2JWbFhPWG8xYW05U2JtYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOmRVSDlzR0VxMjBwbVlXOXo1am9Sbmc%7C%7C?hl=en" }, { reviewer: "Lane Milburn", rating: "5.0", iso_date: "2026-05-27T21:15:22Z", review: "Highlights did a great job installing a new lighting fixture in my home. Scheduling was easy, and the work was done quickly and professionally. Highly recommended!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2s1bExVVkdkSFp1Y0Mxc2RqWlNVekJ2YTBocWRWRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOk5lLUVGdHZucC1sdjZSUzBva0hqdVE%7C%7C?hl=en" }, { reviewer: "donna djinovich", rating: "5.0", iso_date: "2026-03-18T22:37:39Z", review: "I needed quite a lot of lighting fixtures installed in my place.  I was impressed with the quality of their work.  Raul and Oscar especially were professional and at the same time very friendly.  I loved how they used drop cloths to catch any materials that would make a mess.  They took quite good care of everything.  I would highly recommend Highlights, day and night!   I am so pleased with the service that I sm asking them to do more work for me.   Thanks for everything!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xVeWNFMW1Za0pNY2w5Q2FFRmpjWGRGY2xKVldGRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOlUycE1mYkJMcl9CaEFjcXdFclJVWFE%7C%7C?hl=en" }, { reviewer: "S R", rating: "5.0", iso_date: "2026-04-12T13:05:06Z", review: "They did amazing job! We asked for a new panel for our apartment, and additional circuits from basement - they did excellent, above and beyond. They took care of the city permits, and once approved they got the job done in half day. Fast and quality job for half the price of other contractor’s estimate, btw. Book them and you won’t regret.", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT21KcVZrOUVVVXhwWmpaclQwaEtRMGhTUzFCSGFtYxAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOmJqVk9EUUxpZjZrT0hKQ0hSS1BHamc%7C%7C?hl=en" }, { reviewer: "Katrina Ta", rating: "5.0", iso_date: "2025-10-18T19:40:52Z", review: "Excellent work! They came to look into installing an EV charger in my building garage and were prompt and communicative. Boz was very knowledgeable and informative. Kaplan and his colleague were professional and did an excellent job with the installation. They also helped me set it up correctly with the app and synced to my car. The charger had to be wired across the garage and it looked professional and barely visible. I highly recommend them! Will use Highlights again for future electrical needs!", review_link: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2taTmNITlRjVkZUUVdkeVdWRmFWSE0xYlZabGFVRRAB!2m1!1s0x0:0xae9382f0c0f6b3b!3m1!1s2@1:CAIQACodChtycF9oOkZNcHNTcVFTQWdyWVFaVHM1bVZlaUE%7C%7C?hl=en" }, { rev