# Highlights Chicago Service Areas: environment template.
# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.

# --- Sanity project (public identifiers, safe to share) ---
NEXT_SANITY_PROJECT_ID=
SANITY_ORGANIZATION_ID=
NEXT_SANITY_DATASET=production
NEXT_SANITY_API_VERSION=2026-03-01
NEXT_SANITY_STUDIO_URL=/service-areas/studio
NEXT_SITE_URL=http://localhost:3008

# --- Sanity tokens (secret) ---
# Viewer token: lets the site read drafts in preview mode.
SANITY_API_READ_TOKEN=
# Editor token: used only by the local import script (pnpm content:push). Never add it to Vercel.
SANITY_API_WRITE_TOKEN=

# --- Sanity webhook -> site revalidation (secret) ---
# Any random string of 32+ characters. Paste the same value into the Sanity webhook's "Secret" field.
SANITY_REVALIDATE_SECRET=

# --- Lead form (optional; leave blank while testing) ---
# Filling these makes test submissions send REAL emails / CRM leads.
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
